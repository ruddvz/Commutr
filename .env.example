# Environment Variables — copy this to .env and fill in values

# App
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database (SQLite for local dev; use Postgres in production)
DATABASE_URL=file:./data/commutr.db

# JWT — required, minimum 32 characters
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Frontend (Vite)
VITE_API_URL=/api
# Optional: full API URL for production / split deploy (overrides proxy)
# VITE_API_BASE_URL=https://api.example.com
# Force offline demo data (also auto-enabled on github.io or when /health fails)
# VITE_DEMO_MODE=true
VITE_USE_FIXTURES=false
